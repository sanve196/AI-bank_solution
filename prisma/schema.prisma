generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Shared
// ============================================
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  useCase    String
  action     String
  entityType String
  entityId   String?
  payload    Json
  createdAt  DateTime @default(now())
  @@index([useCase, createdAt])
}

model AICall {
  id           String   @id @default(cuid())
  userId       String?
  useCase      String
  promptId     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  request      Json
  response     Json
  createdAt    DateTime @default(now())
  @@index([useCase, createdAt])
}

// ============================================
// UC-01 SOP Deviation Identification
// ============================================
model Application {
  id             String       @id @default(cuid())
  applicantName  String
  productType    String
  status         String       @default("DRAFT")
  extractedData  Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deviations     Deviation[]
  @@index([createdAt])
}

model Deviation {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  severity      String
  sopClauseId   String
  expectedValue String
  actualValue   String
  justification String
  status        String      @default("OPEN")
  reviewerNote  String?
  createdAt     DateTime    @default(now())
  @@index([applicationId])
}

// ============================================
// UC-04 Customer Onboarding
// ============================================
model Onboarding {
  id             String   @id @default(cuid())
  applicantName  String
  applicantType  String   // INDIVIDUAL | SME | CORPORATE
  productType    String   // SAVINGS | CURRENT | TERM_LOAN | WORKING_CAPITAL
  status         String   @default("DRAFT") // DRAFT | VERIFYING | REVIEW | APPROVED | REJECTED
  kycData        Json?    // extracted KYC fields
  verificationResults Json? // cross-check results
  covenants      Json?    // configured covenants
  accountNumber  String?
  aiSummary      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([createdAt])
}

// ============================================
// UC-09 Regulatory Companion
// ============================================
model Regulation {
  id             String   @id @default(cuid())
  regulator      String   // RBI | SEBI | IRDAI | MOF
  title          String
  circularNumber String?
  publishedAt    DateTime
  fullText       String   @db.Text
  summary        String?  @db.Text
  obligations    Json?    // parsed obligations array
  impactMatrix   Json?    // affected policies/products
  status         String   @default("NEW") // NEW | ANALYZED | ACKNOWLEDGED
  createdAt      DateTime @default(now())
  @@index([regulator, publishedAt])
}

// ============================================
// UC-06 Process Analytics (chat sessions)
// ============================================
model ChatSession {
  id        String        @id @default(cuid())
  useCase   String        // UC-06 or UC-07
  title     String        @default("New chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  @@index([useCase, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // user | assistant
  content   String      @db.Text
  data      Json?       // optional chart data
  createdAt DateTime    @default(now())
  @@index([sessionId, createdAt])
}

// Process events feed the analytics
model ProcessEvent {
  id         String   @id @default(cuid())
  useCase    String
  entityId   String
  stage      String
  actorRole  String
  branch     String?
  durationMs Int
  createdAt  DateTime @default(now())
  @@index([useCase, createdAt])
  @@index([branch])
}

// ============================================
// UC-11 Case Investigation & Reporting
// ============================================
model InvestigationCase {
  id              String   @id @default(cuid())
  caseNumber      String   @unique
  customerName    String
  customerId      String?
  alertSources    Json     // array of alerts triggering this case
  transactions    Json?    // related transaction snapshot
  narrative       String?  @db.Text
  redFlags        Json?
  recommendation  String?  @db.Text
  status          String   @default("OPEN") // OPEN | IN_REVIEW | FILED | CLOSED
  reportType      String   @default("STR")  // STR | SAR | INTERNAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status, createdAt])
}
