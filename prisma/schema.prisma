generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Shared entities (used across all use cases)
// ============================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("OFFICER") // OFFICER | MANAGER | COMPLIANCE | ADMIN
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  useCase    String
  action     String
  entityType String
  entityId   String?
  payload    Json
  createdAt  DateTime @default(now())
  @@index([useCase, createdAt])
}

model AICall {
  id           String   @id @default(cuid())
  userId       String?
  useCase      String
  promptId     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  request      Json
  response     Json
  createdAt    DateTime @default(now())
  @@index([useCase, createdAt])
}

// ============================================
// UC-01: SOP Deviation Identification
// ============================================
model Application {
  id             String   @id @default(cuid())
  applicantName  String
  productType    String
  status         String   @default("DRAFT") // DRAFT | ANALYZING | REVIEW | APPROVED | REJECTED
  extractedData  Json?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deviations     Deviation[]
}

model Deviation {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  severity      String   // CRITICAL | MAJOR | MINOR
  sopClauseId   String
  expectedValue String
  actualValue   String
  justification String
  status        String   @default("OPEN") // OPEN | APPROVED_OVERRIDE | REJECTED
  reviewerNote  String?
  createdAt     DateTime @default(now())
  @@index([applicationId])
}
